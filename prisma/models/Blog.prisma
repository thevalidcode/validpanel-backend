enum BlogStatus {
  ACTIVE      @map("active")
  DISABLED    @map("disabled")
}

model Blog {
  id             Int     @id @default(autoincrement())
  title       String
  content     String
  description String   @default("")
  coverImage  String   @default("") @map("cover_image")
  status      BlogStatus    @default(ACTIVE)
  position    Int
  slug        String
  uid         String   @unique
  timestamp   DateTime @default(now())

  @@map("blogs")
}