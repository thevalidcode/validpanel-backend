enum StoreStatus {
  ACTIVE      @map("active")
  PENDING     @map("pending")
  INACTIVE    @map("inactive")
  DISABLED    @map("disabled")
}

enum StoreType {
  SOCIAL   @map("social_media_store")
  SHOP     @map("shop")
  DIGITAL  @map("digital")
}

model Store {
  storeId   Int         @id @map("store_id")
  uid       String      @unique
  name      String
  description String?
  ssl       Boolean     @default(false)
  plan      UserPlan    @default(FREE)
  type      StoreType
  status    StoreStatus @default(PENDING)
  timestamp DateTime    @default(now())
  ownerId  Int
  owner    User   @relation(fields: [ownerId], references: [id])
  
  @@map("stores")
}