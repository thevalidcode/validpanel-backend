enum FaqStatus {
  ACTIVE      @map("active")
  DISABLED    @map("disabled")
}

model Faq {
  id             Int     @id @default(autoincrement())
  question  String
  answer    String
  status    FaqStatus   @default(ACTIVE)
  position  Int
  slug      String
  uid       String   @unique
  timestamp DateTime @default(now())

  @@map("faqs")
}
