generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  ACTIVE   @map("active")
  PENDING  @map("pending")
  CANCELED @map("canceled")
  DISABLED @map("disabled")
  EXPIRED  @map("expired")
}

enum StoreType {
  SOCIAL  @map("social_media_store")
  SHOP    @map("shop")
  DIGITAL @map("digital")
}

enum BillingInterval {
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")
}

model Store {
  storeId     Int         @id @default(autoincrement()) @map("store_id")
  uid         String      @unique @default(uuid())
  name        String
  logoUrl     String?     @map("logo_url")
  color       String?
  description String?
  ssl         Boolean     @default(false)
  plan        String
  type        StoreType
  status      StoreStatus @default(PENDING)
  timestamp   DateTime    @default(now())
  ownerId     Int
  owner       User        @relation(fields: [ownerId], references: [id])

  @@map("stores")
}

enum SubscriptionStatus {
  ACTIVE   @map("active")
  PENDING  @map("pending")
  FAILED   @map("failed")
  EXPIRED  @map("expired")
  TRIAL    @map("trial")
  CANCELED @map("canceled")
}

enum PaymentStatus {
  PENDING @map("pending")
  SUCCESS @map("success")
  FAILED  @map("failed")
}

enum SubscriptionPlanStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  DRAFT    @map("draft")
}

model SubscriptionPlan {
  id                  Int                    @id @default(autoincrement())
  uid                 String                 @unique @default(uuid())
  name                String
  price               Decimal                @db.Decimal(10, 2)
  currency            String
  description         String?
  status              SubscriptionPlanStatus @default(ACTIVE)
  features            Json
  tax                 Int?
  discountForAnnually Int?                   @map("discount_for_annually")
  interval            BillingInterval
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  gracePeriod         Int?                   @map("grace_period") // number of days allowed for overdue subscription

  subscriptions        Subscription[] @relation("ActivePlan") // active subscriptions
  pendingSubscriptions Subscription[] @relation("PendingPlan") // scheduled downgrades
  Payment              Payment[]

  @@map("subscription_plans")
}

model Subscription {
  id            Int                @id @default(autoincrement())
  uid           String             @unique @default(uuid())
  userId        Int                @map("user_id")
  planId        Int                @map("plan_id")
  pendingPlanId Int?               @map("pending_plan_id")
  status        SubscriptionStatus
  billingCycle  BillingInterval    @map("billing_cycle")
  startedAt     DateTime           @default(now()) @map("started_at")
  expiresAt     DateTime?          @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id])
  plan        SubscriptionPlan  @relation("ActivePlan", fields: [planId], references: [id])
  pendingPlan SubscriptionPlan? @relation("PendingPlan", fields: [pendingPlanId], references: [id])

  @@map("subscriptions")
}

model Payment {
  id            Int           @id @default(autoincrement())
  uid           String        @unique @default(uuid())
  userId        Int           @map("user_id")
  planId        Int           @map("plan_id")
  currency      String
  amount        Decimal       @db.Decimal(10, 2)
  chargedAmount Decimal       @map("charged_amount") @db.Decimal(10, 2)
  status        PaymentStatus
  method        PaymentMethod
  createdAt     DateTime      @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("payments")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  BANNED   @map("banned")
}

enum OnboardingStep {
  PLAN          @map("plan")
  PAYMENT       @map("payment")
  STORE_DETAILS @map("store_details")
  COMPLETE      @map("complete")
}

model User {
  id               Int            @id @default(autoincrement())
  refCode          Int?           @unique @default(autoincrement()) @map("ref_code")
  uid              String         @unique @default(uuid())
  email            String         @unique
  fullName         String
  phoneNumber      String?        @map("phone_number")
  image            String?
  onboardingStep   OnboardingStep @default(PLAN) @map("onboarding_step")
  password         String
  apiKey           String         @unique @map("api_key")
  status           UserStatus     @default(ACTIVE)
  balance          Decimal        @default(0.00) @db.Decimal(10, 2)
  spent            Decimal        @default(0.00) @db.Decimal(10, 2)
  timestamp        DateTime       @default(now())
  lastSeen         DateTime       @default(now()) @map("last_seen")
  currency         String         @default("USD")
  resetToken       String?        @map("reset_token")
  resetTokenExpiry DateTime?      @map("reset_token_expiry")

  updatedAt DateTime @updatedAt @map("updated_at")

  ref           Int?
  referredBy    User?           @relation("Referral", fields: [ref], references: [refCode], onDelete: SetNull)
  referrals     User[]          @relation("Referral")
  subscriptions Subscription[]
  stores        Store[]
  payments      Payment[]
  Notification  Notification[]
  UploadLog     UploadLog[]
  PlatformEvent PlatformEvent[]

  @@map("users")
}

enum AdminStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  BANNED   @map("banned")
}

model Admin {
  id               Int         @id @default(autoincrement())
  uid              String      @unique @default(uuid())
  email            String      @unique
  image            String?
  password         String
  fullName         String
  apiKey           String      @unique @map("api_key")
  roleId           Int
  role             AdminRole   @relation(fields: [roleId], references: [id])
  status           AdminStatus @default(ACTIVE)
  timestamp        DateTime    @default(now())
  lastSeen         DateTime    @default(now()) @map("last_seen")
  resetToken       String?     @map("reset_token")
  resetTokenExpiry DateTime?   @map("reset_token_expiry")

  updatedAt     DateTime        @updatedAt @map("updated_at")
  PlatformEvent PlatformEvent[]
  UploadLog     UploadLog[]

  @@map("admins")
}

enum OrderStatus {
  PENDING    @map("Pending")
  CANCELED   @map("Canceled")
  PARTIAL    @map("Partial")
  FAILED     @map("Failed")
  COMPLETED  @map("Completed")
  ACTIVE     @map("In progress")
  PROCESSING @map("Processing")
}

model Order {
  id        Int         @id @default(autoincrement())
  uid       String      @unique @default(uuid())
  timestamp DateTime    @default(now())
  userUid   String      @map("user_uid")
  currency  String      @default("USD")
  status    OrderStatus @default(PENDING)
  quantity  Int
  start     Int         @default(0)
  price     Decimal     @default(0.00) @db.Decimal(10, 2)

  @@map("orders")
}

enum BlogStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

model Blog {
  id          Int        @id @default(autoincrement())
  title       String
  content     String
  description String     @default("")
  coverImage  String     @default("") @map("cover_image")
  status      BlogStatus @default(ACTIVE)
  position    Int        @default(autoincrement())
  slug        String
  uid         String     @unique @default(uuid())
  timestamp   DateTime   @default(now())

  @@map("blogs")
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  rates     Json

  @@map("exchange_rates")
}

enum EmailStatus {
  SUCCESS @map("success")
  ERROR   @map("error")
}

model EmailLog {
  id        Int         @id @default(autoincrement())
  uid       String      @unique @default(uuid())
  sender    String
  receiver  String
  subject   String
  html      String
  status    EmailStatus
  messageId String?     @map("message_id")
  response  String?
  timestamp DateTime    @default(now())

  @@map("email_logs")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  type      String // e.g., "PASSWORD_RESET", "WELCOME_USER"
  name      String? // human-readable name
  subject   String // optional default subject
  content   String // HTML template with {{variables}}
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

enum FaqStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

model Faq {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String
  status    FaqStatus @default(ACTIVE)
  position  Int       @default(autoincrement())
  slug      String
  uid       String    @unique @default(uuid())
  timestamp DateTime  @default(now())

  @@map("faqs")
}

enum MaintenanceStatus {
  ENABLED  @map("enabled")
  DISABLED @map("disabled")
}

model Setting {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(uuid())

  // Site Information
  siteName        String  @default("Valid Panel") @map("site_name")
  siteDescription String? @map("site_description")
  adminEmail      String? @map("admin_email")
  logoUrl         String? @map("logo_url")
  faviconUrl      String? @map("favicon_url")
  defaultCurrency String  @default("USD") @map("default_currency")
  timezone        String  @default("UTC")
  defaultLanguage String  @default("English") @map("default_language")
  dateFormat      String  @default("MM/DD/YYYY") @map("date_format")

  // Maintenance Mode
  maintenanceMode  MaintenanceStatus @default(DISABLED) @map("maintenance_mode")
  maintenanceMsg   String?           @map("maintenance_msg")
  maintenanceStart DateTime?         @map("maintenance_start")
  maintenanceEnd   DateTime?         @map("maintenance_end")
  allowedIps       Json?             @map("allowed_ips") // store as array of IPs

  // API Rate Limits
  requestsPerMinute Int @default(60) @map("requests_per_minute")
  requestsPerHour   Int @default(1000) @map("requests_per_hour")
  requestsPerDay    Int @default(10000) @map("requests_per_day")

  // Login Limits
  maxLoginAttempts Int @default(5) @map("max_login_attempts")
  lockoutDuration  Int @default(15) @map("lockout_duration") // in minutes

  // Upload Limits
  maxFileSizeMb     Int @default(10) @map("max_file_size_mb")
  uploadsPerHour    Int @default(20) @map("uploads_per_hour")
  concurrentUploads Int @default(3) @map("concurrent_uploads")

  // Throttling Options
  progressiveDelays Boolean @default(true) @map("progressive_delays")
  blockSuspiciousIp Boolean @default(true) @map("block_suspicious_ip")
  sendEmailAlerts   Boolean @default(true) @map("send_email_alerts")
  whitelistedIps    Json?   @map("whitelisted_ips") // array of IPs

  staleItemThreshold Int?     @default(7) @map("stale_item_threshold") // number of days before marking items as failed
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model InternalApiSession {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internal_api_sessions")
}

enum PaymentGatewayStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

enum PaymentMethod {
  MANUAL      @map("manual")
  FLUTTERWAVE @map("flutterwave")
  PAYSTACK    @map("paystack")
  CRON        @map("cron")
}

model PaymentGateway {
  id                 Int                  @id @default(autoincrement())
  uid                String               @unique @default(uuid())
  platform           PaymentMethod        @default(MANUAL)
  name               String
  description        String?
  signature          String?
  encryptedSecretKey String?              @map("encrypted_secret_key")
  iv                 String?
  content            String?
  image              String
  status             PaymentGatewayStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  position           Int                  @default(autoincrement())
  min                Decimal              @db.Decimal(10, 2)
  max                Decimal              @db.Decimal(10, 2)

  @@map("payment_gateways")
}

model SessionCode {
  code      String   @id
  email     String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@map("session_codes")
}

enum TicketStatus {
  OPEN     @map("open")
  PENDING  @map("pending")
  RESOLVED @map("resolved")
  CLOSED   @map("closed")
}

enum TicketPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

model SupportTicket {
  id          Int            @id @default(autoincrement())
  uid         String         @unique @default(uuid())
  description String?
  userUid     String         @map("user_uid")
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  messages TicketMessage[] @relation("TicketMessages")

  @@index([userUid])
  @@map("support_tickets")
}

enum MessageSenderType {
  USER  @map("user")
  ADMIN @map("admin")
}

model TicketMessage {
  id         Int               @id @default(autoincrement())
  uid        String            @unique @default(uuid())
  ticketUid  String            @map("ticket_uid")
  senderUid  String            @map("sender_uid")
  senderType MessageSenderType @map("sender_type")
  message    String
  createdAt  DateTime          @default(now()) @map("created_at")

  ticket SupportTicket @relation("TicketMessages", fields: [ticketUid], references: [uid])

  @@index([ticketUid])
  @@index([senderUid])
  @@map("ticket_messages")
}

enum TransactionStatus {
  SUCCESS   @map("success")
  PENDING   @map("pending")
  FAILED    @map("failed")
  COMPLETED @map("completed")
  REVERSED  @map("reversed")
  CANCELLED @map("cancelled")
}

enum TransactionType {
  SUBSCRIPTION_PAYMENT   @map("subscription_payment") // user pays for a plan
  SUBSCRIPTION_RENEWAL   @map("subscription_renewal") // auto/manual renewal
  SUBSCRIPTION_UPGRADE   @map("subscription_upgrade")
  SUBSCRIPTION_DOWNGRADE @map("subscription_downgrade")

  MANUAL_CREDIT @map("manual_credit") // admin tops up / compensates user
  MANUAL_DEBIT  @map("manual_debit") // admin deducts
}

model Transaction {
  id        Int               @id @default(autoincrement())
  uid       String            @unique @default(uuid())
  amount    Decimal           @db.Decimal(10, 2)
  timestamp DateTime          @default(now())
  status    TransactionStatus
  type      TransactionType
  currency  String            @default("USD")
  userUid   String            @map("user_uid")

  @@map("transactions")
}

model UploadLog {
  id         Int      @id @default(autoincrement())
  uid        String   @unique @default(uuid())
  size       Int
  url        String
  filename   String
  userId     Int?
  adminId    Int?
  collection String
  mimetype   String
  timestamp  DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  admin Admin? @relation(fields: [adminId], references: [id])

  @@map("upload_logs")
}

model AdminRole {
  id          Int                   @id @default(autoincrement())
  uid         String                @unique @default(uuid())
  name        String                @unique
  admins      Admin[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id    Int                   @id @default(autoincrement())
  uid   String                @unique @default(uuid())
  name  String                @unique
  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  id           Int             @id @default(autoincrement())
  roleId       Int
  permissionId Int             @map("permissin_id")
  role         AdminRole       @relation(fields: [roleId], references: [id])
  permission   AdminPermission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("admin_role_permissions")
}

enum ServiceProviderStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

model ServiceApiProvider {
  id        Int                   @id @default(autoincrement())
  uid       String                @unique @default(uuid())
  name      String
  url       String
  image     String?
  status    ServiceProviderStatus @default(ACTIVE)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@map("service_api_provders")
}

enum NotificationCategory {
  SYSTEM       @map("system")
  PAYMENT      @map("payment")
  SUBSCRIPTION @map("subscription")
  STORE        @map("store")
  USER         @map("user")
}

model Notification {
  id        Int                  @id @default(autoincrement())
  uid       String               @unique @default(uuid())
  userId    Int?                 @map("user_id")
  category  NotificationCategory @map("category")
  title     String
  message   String
  meta      Json? // Flexible details: { "status": "success", "txId": "xxx", "amount": 2000 }
  isRead    Boolean              @default(false) @map("is_read")
  createdAt DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

enum PlatformEventCategory {
  STORE        @map("store")
  USER         @map("user")
  ADMIN        @map("admin")
  SUBSCRIPTION @map("subscription")
  PAYMENT      @map("payment")
  SYSTEM       @map("system")
}

model PlatformEvent {
  id        Int                    @id @default(autoincrement())
  uid       String                 @unique @default(uuid())
  userId    Int?                   @map("user_id")
  adminId   Int?                   @map("admin_id")
  event     String // e.g. STORE_CREATED, USER_LOGIN
  category  PlatformEventCategory?
  entityUid String?                @map("entity_uid") // e.g transaction or payment or user uid
  createdAt DateTime               @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id])
  admin Admin? @relation(fields: [adminId], references: [id])

  @@index([event])
  @@index([createdAt])
  @@map("platform_events")
}
