generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  ACTIVE   @map("active")
  PENDING  @map("pending")
  CANCELED @map("canceled")
  DISABLED @map("disabled")
  EXPIRED  @map("expired")
}

enum StoreType {
  SOCIAL  @map("social_media_store")
  SHOP    @map("shop")
  DIGITAL @map("digital")
}

enum BillingInterval {
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")
}

model Store {
  storeId     Int         @id @default(autoincrement()) @map("store_id")
  uid         String      @unique
  name        String
  description String?
  ssl         Boolean     @default(false)
  plan        String
  type        StoreType
  status      StoreStatus @default(PENDING)
  timestamp   DateTime    @default(now())
  ownerId     Int
  owner       User        @relation(fields: [ownerId], references: [id])

  @@map("stores")
}

enum SubscriptionStatus {
  ACTIVE   @map("active")
  PENDING  @map("pending")
  FAILED   @map("failed")
  EXPIRED  @map("expired")
  TRIAL    @map("trial")
  CANCELED @map("canceled")
}

enum PaymentStatus {
  PENDING @map("pending")
  SUCCESS @map("success")
  FAILED  @map("failed")
}

model SubscriptionPlan {
  id        Int             @id @default(autoincrement())
  uid       String          @unique @default(uuid())
  name      String
  price     Decimal
  currency  String
  features  Json
  interval  BillingInterval
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  subscriptions Subscription[]
  Payment       Payment[]

  @@map("subscription_plans")
}

model Subscription {
  id        Int                @id @default(autoincrement())
  uid       String             @unique @default(uuid())
  userId    Int                @map("user_id")
  planId    Int                @map("plan_id")
  status    SubscriptionStatus
  startedAt DateTime           @default(now()) @map("started_at")
  expiresAt DateTime?          @map("expires_at")

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Payment {
  id            Int           @id @default(autoincrement())
  uid           String        @unique @default(uuid())
  userId        Int           @map("user_id")
  planId        Int           @map("plan_id")
  currency      String
  amount        Decimal
  chargedAmount Decimal       @map("charged_amount")
  status        PaymentStatus
  method        PaymentMethod
  createdAt     DateTime      @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("payments")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  BANNED   @map("banned")
}

enum OnboardingStep {
  PLAN          @map("plan")
  PAYMENT       @map("payment")
  STORE_DETAILS @map("store_details")
  COMPLETE      @map("complete")
}

model User {
  id             Int            @id @default(autoincrement())
  refCode        Int?           @unique @default(autoincrement()) @map("ref_code")
  uid            String         @unique
  email          String
  fullName       String
  image          String?
  onboardingStep OnboardingStep @default(PLAN) @map("onboarding_step")
  password       String
  apiKey         String         @unique @map("api_key")
  status         UserStatus     @default(ACTIVE)
  balance        Decimal        @default(0.00) @db.Decimal(10, 2)
  spent          Decimal        @default(0.00) @db.Decimal(10, 2)
  timestamp      DateTime       @default(now())
  lastSeen       DateTime       @default(now()) @map("last_seen")
  currency       String         @default("USD")

  ref           Int?
  referredBy    User?          @relation("Referral", fields: [ref], references: [refCode], onDelete: SetNull)
  referrals     User[]         @relation("Referral")
  subscriptions Subscription[]
  stores        Store[]
  payments      Payment[]

  @@map("users")
}

enum AdminStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  BANNED   @map("banned")
}

model Admin {
  id        Int         @id @default(autoincrement())
  uid       String      @unique
  email     String
  image     String?
  password  String
  fullName  String
  apiKey    String      @unique @map("api_key")
  roleId    Int
  role      AdminRole   @relation(fields: [roleId], references: [id])
  status    AdminStatus @default(ACTIVE)
  timestamp DateTime    @default(now())
  lastSeen  DateTime    @default(now()) @map("last_seen")

  @@map("admins")
}

enum OrderStatus {
  PENDING    @map("Pending")
  CANCELED   @map("Canceled")
  PARTIAL    @map("Partial")
  FAILED     @map("Failed")
  COMPLETED  @map("Completed")
  ACTIVE     @map("In progress")
  PROCESSING @map("Processing")
}

model Order {
  id        Int         @id @default(autoincrement())
  uid       String      @unique
  timestamp DateTime    @default(now())
  userUid   String      @map("user_uid")
  currency  String      @default("USD")
  status    OrderStatus @default(PENDING)
  quantity  Int
  start     Int         @default(0)
  price     Decimal     @default(0.00) @db.Decimal(10, 2)

  @@map("orders")
}

enum BlogStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

model Blog {
  id          Int        @id @default(autoincrement())
  title       String
  content     String
  description String     @default("")
  coverImage  String     @default("") @map("cover_image")
  status      BlogStatus @default(ACTIVE)
  position    Int        @default(autoincrement())
  slug        String
  uid         String     @unique
  timestamp   DateTime   @default(now())

  @@map("blogs")
}

model Currency {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  timestamp DateTime @default(now())
  quotes    Json

  @@map("currencies")
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  sender    String
  receiver  String
  subject   String
  html      String
  status    String
  messageId String?  @map("message_id")
  response  String?
  timestamp DateTime @default(now())

  @@map("email_logs")
}

enum FaqStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

model Faq {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String
  status    FaqStatus @default(ACTIVE)
  position  Int       @default(autoincrement())
  slug      String
  uid       String    @unique
  timestamp DateTime  @default(now())

  @@map("faqs")
}

model General {
  id         Int     @id @default(autoincrement())
  uid        String  @unique
  title      String  @default("Valid Panel")
  logoUrl    String? @map("logo_url")
  faviconUrl String? @map("favicon_url")

  @@map("general")
}

model InternalApiSession {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internal_api_sessions")
}

enum PaymentGatewayStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

enum PaymentMethod {
  MANUAL      @map("manual")
  FLUTTERWAVE @map("flutterwave")
  PAYSTACK    @map("paystack")
}

model PaymentGateway {
  id                 Int                  @id @default(autoincrement())
  uid                String               @unique
  platform           PaymentMethod        @default(MANUAL)
  name               String
  description        String?
  signature          String?
  encryptedSecretKey String?              @map("encrypted_secret_key")
  iv                 String?
  image              String
  status             PaymentGatewayStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  position           Int                  @default(autoincrement())
  min                Decimal              @db.Decimal(10, 2)
  max                Decimal              @db.Decimal(10, 2)

  @@map("payment_gateways")
}

model SessionCode {
  code      String   @id
  email     String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@map("session_codes")
}

enum TicketStatus {
  OPEN     @map("open")
  PENDING  @map("pending")
  RESOLVED @map("resolved")
  CLOSED   @map("closed")
}

enum TicketPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

model SupportTicket {
  id          Int            @id @default(autoincrement())
  uid         String         @unique @default(uuid())
  description String?
  userUid     String         @map("user_uid")
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  messages TicketMessage[] @relation("TicketMessages")

  @@index([userUid])
  @@map("support_tickets")
}

enum MessageSenderType {
  USER  @map("user")
  ADMIN @map("admin")
}

model TicketMessage {
  id         Int               @id @default(autoincrement())
  uid        String            @unique @default(uuid())
  ticketUid  String            @map("ticket_uid")
  senderUid  String            @map("sender_uid")
  senderType MessageSenderType @map("sender_type")
  message    String
  createdAt  DateTime          @default(now()) @map("created_at")

  ticket SupportTicket @relation("TicketMessages", fields: [ticketUid], references: [uid])

  @@index([ticketUid])
  @@index([senderUid])
  @@map("ticket_messages")
}

enum TransactionStatus {
  SUCCESS   @map("success")
  FAILED    @map("failed")
  COMPLETED @map("completed")
  REVERSED  @map("reversed")
  CANCELLED @map("cancelled")
}

enum TransactionType {
  SUBSCRIPTION_PAYMENT @map("subscription_payment") // user pays for a plan
  SUBSCRIPTION_RENEWAL @map("subscription_renewal") // auto/manual renewal
  SUBSCRIPTION_REFUND  @map("subscription_refund") // refund to user

  ADDON_PURCHASE @map("addon_purchase") // e.g. extra storage, extra feature
  ADDON_REFUND   @map("addon_refund")

  MANUAL_CREDIT @map("manual_credit") // admin tops up / compensates user
  MANUAL_DEBIT  @map("manual_debit") // admin deducts
}

model Transaction {
  id        Int               @id @default(autoincrement())
  uid       String            @unique
  amount    Decimal           @db.Decimal(10, 2)
  timestamp DateTime          @default(now())
  status    TransactionStatus
  type      TransactionType
  currency  String            @default("USD")
  userUid   String            @map("user_uid")

  @@map("transactions")
}

model UploadLog {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  size      Int
  url       String
  filename  String
  mimetype  String
  timestamp DateTime @default(now())

  @@map("upload_logs")
}

model AdminRole {
  id          Int                   @id @default(autoincrement())
  uid         String                @unique @default(uuid())
  name        String                @unique
  admins      Admin[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id    Int                   @id @default(autoincrement())
  uid   String                @unique @default(uuid())
  name  String                @unique
  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  id           Int             @id @default(autoincrement())
  roleId       Int
  permissionId Int             @map("permissin_id")
  role         AdminRole       @relation(fields: [roleId], references: [id])
  permission   AdminPermission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("admin_role_permissions")
}

enum ServiceProviderStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

model ServiceApiProvider {
  id        Int                   @id @default(autoincrement())
  uid       String                @unique @default(uuid())
  name      String
  url       String
  image     String?
  status    ServiceProviderStatus @default(ACTIVE)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@map("service_api_provders")
}
